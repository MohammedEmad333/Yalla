# ملفّات Flutter/Dart المولّدة محليًا
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml

# محرّرات
.idea/
.vscode/

# Android project is tracked in Git; ignore only local/generated Android files.
/android/.gradle/
/android/local.properties
/android/key.properties
/android/*.iml
/android/app/build/
/ios/
/linux/
/macos/
/windows/

# مخرجات البناء (APK/AAB)
*.apk
*.aab

# مفاتيح التوقيع — لا تُرفع أبدًا إلى المستودع (تُحقَن في CI عبر الأسرار)
*.jks
*.keystore
/android/app/upload-keystore.jks

# ملفّات بايثون المؤقّتة
__pycache__/
*.pyc

# ملفات Flutter المولّدة
**/GeneratedPluginRegistrant.java
