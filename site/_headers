# قواعد ترويسات HTTP للموقع العام على Cloudflare Workers Static Assets.

# لا تخزّن الـService Worker في الكاش حتى تصل التحديثات فورًا للمستخدمين
/sw.js
  Cache-Control: no-cache

# نوع المحتوى الصحيح لملف الـmanifest
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# الأيقونات والشعارات — كاش طويل (ملفات ثابتة لا تتغيّر كثيرًا)
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/logo.png
  Cache-Control: public, max-age=604800

# ترويسات أمان عامة لكل الصفحات. نسمح فقط بخطوط Google المستخدمة في الموقع
# وبـ inline styles/scripts لأن بعض الصفحات القانونية/التحويلية تعتمد مقاطع صغيرة مضمّنة.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
