# ترويسات Cloudflare لتطبيق يلا الويب (Flutter build)
# https://developers.cloudflare.com/workers/static-assets/headers/

# لا تخزّن نقطة الدخول ولا مُحمّل Flutter — تصل التحديثات فورًا
/index.html
  Cache-Control: no-store, max-age=0, must-revalidate
/flutter_bootstrap.js
  Cache-Control: no-store, max-age=0, must-revalidate
/flutter_service_worker.js
  Cache-Control: no-store, max-age=0, must-revalidate
/version.json
  Cache-Control: no-store, max-age=0, must-revalidate
/manifest.json
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: application/manifest+json

# كود التطبيق: اسم ثابت (main.dart.js) يتغيّر مع كل بناء — لا نخزّنه بكاش طويل
# وإلّا بقي المستخدم على نسخة قديمة أيامًا. no-cache = تحقّق دائمًا (ETag/304).
/main.dart.js
  Cache-Control: no-store, max-age=0, must-revalidate

# أصول Flutter الثقيلة — canvaskit يحمل نسخة في مساره فيُخزَّن للأبد؛ الأصول أقصر
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=3600

# ترويسات أمان عامة
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin


# صفحة تنظيف الكاش لا تُخزَّن إطلاقًا
/reset-cache.html
  Cache-Control: no-store, max-age=0, must-revalidate
  Clear-Site-Data: "cache"

/flutter_service_worker.js
  Cache-Control: no-store, max-age=0, must-revalidate
