# ترويسات Cloudflare لتطبيق يلا الويب (Flutter build)
# https://developers.cloudflare.com/workers/static-assets/headers/

/index.html
  Cache-Control: no-store, max-age=0, must-revalidate
/flutter_bootstrap.js
  Cache-Control: no-store, max-age=0, must-revalidate
/flutter_service_worker.js
  Cache-Control: no-store, max-age=0, must-revalidate
/version.json
  Cache-Control: no-store, max-age=0, must-revalidate
/manifest.json
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: application/manifest+json
/main.dart.js
  Cache-Control: no-store, max-age=0, must-revalidate

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=3600

# ترويسات أمان عامة. CSP هنا متوافقة مع Flutter Web/CanvasKit وتمنع framing.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.yalladelivery.org wss://api.yalladelivery.org; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

/reset-cache.html
  Cache-Control: no-store, max-age=0, must-revalidate
  Clear-Site-Data: "cache"

/flutter_service_worker.js
  Cache-Control: no-store, max-age=0, must-revalidate
