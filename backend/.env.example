# إعدادات الخادم
PORT=4000
NODE_ENV=development

# قاعدة البيانات
MONGO_URI=mongodb://127.0.0.1:27017/yalla

# مفتاح توقيع الـ JWT (غيّره في الإنتاج)
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=7d

# مصدر الطلبات المسموح (لوحة الأدمن / الموبايل)
CORS_ORIGIN=*

# إسناد الطلب تلقائيًا لأقرب كابتن عند إنشائه (true/false)
AUTO_ASSIGN=false

# نسبة عمولة الشركة من قيمة كل توصيلة (0.2 = 20%)
COMMISSION_RATE=0.2

# مهلة قبول الكابتن للطلب قبل إعادة إسناده (ثوانٍ)
ACCEPT_TIMEOUT_SECONDS=60

# مسار ملف اعتماد Firebase (JSON) لإشعارات FCM — اتركه فارغًا لتعطيل الإشعارات
FCM_CREDENTIALS_PATH=

# مفتاح خرائط جوجل (يُستخدم من العميل عادةً)
GOOGLE_MAPS_API_KEY=your_google_maps_key
