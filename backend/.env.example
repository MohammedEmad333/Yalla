# إعدادات الخادم
PORT=4000
# التطوير/Docker المحلي يحتاج 0.0.0.0. على Oracle production استخدم 127.0.0.1
# لأن الوصول العام يمر عبر Cloudflare Tunnel.
API_BIND_HOST=0.0.0.0
NODE_ENV=development

# قاعدة البيانات
MONGO_URI=mongodb://127.0.0.1:27017/yalla

# تخزين الصور العامة على القرص. في Docker/Oracle يربطه deploy إلى /app/media.
# عند تشغيل Node مباشرةً يمكن تركه فارغًا ليستخدم backend/media تلقائيًا.
MEDIA_ROOT=

# مفتاح توقيع الـ JWT.
# التطوير المحلي فقط يمكنه استخدام القيمة الافتراضية أدناه.
# الإنتاج يرفض الإقلاع إذا كانت القيمة مفقودة/افتراضية/أقصر من 32 محرفًا.
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=7d

# مصدر الطلبات المسموح (لوحة الأدمن / تطبيق الويب / الموبايل).
# رابط واحد، أو عدّة روابط مفصولة بفاصلة. استخدم * للتطوير المحلي فقط؛
# الإنتاج يرفض الإقلاع إذا كانت CORS_ORIGIN فارغة أو *.
# مثال:
# CORS_ORIGIN=https://gazalook-admin.netlify.app,https://yalla.workers.dev
CORS_ORIGIN=*

# إسناد الطلب تلقائيًا لأقرب كابتن عند إنشائه (true/false)
AUTO_ASSIGN=false

# نسبة عمولة الشركة من قيمة كل توصيلة (0.2 = 20%)
COMMISSION_RATE=0.2

# مهلة قبول الكابتن للطلب قبل إعادة إسناده (ثوانٍ)
ACCEPT_TIMEOUT_SECONDS=60

# مسار ملف اعتماد Firebase (JSON) لإشعارات FCM — اتركه فارغًا لتعطيل الإشعارات
FCM_CREDENTIALS_PATH=

# مفتاح خرائط جوجل (يُستخدم من العميل عادةً)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ===== البريد الإلكتروني (Brevo SMTP) =====
# اترك SMTP_PASS فارغًا لتعطيل الإرسال محليًا.
# في الإنتاج خزّن المفتاح في ملف البيئة على السيرفر فقط ولا ترفعه إلى GitHub.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@yalladelivery.org
SMTP_FROM_NAME=Yalla Delivery

# ===== تكامل بوت واتساب =====
# Shared secret طويل وعشوائي يسمح للبوت بقراءة سياق دعم محدود فقط
# (آخر طلب + الرصيد المتاح) عبر /api/bot/customer-context.
# استخدم نفس القيمة في YALLA_BOT_API_TOKEN على خادم البوت.
BOT_API_TOKEN=


# ===== الدفع المباشر عبر جوال =====
# مفاتيح البوابة تبقى على الخادم فقط ولا تُضاف إلى Flutter أو GitHub.
JAWWAL_PAY_BASE_URL=https://api.leadersms.ps
# basic أو oauth2
JAWWAL_PAY_AUTH_MODE=basic
JAWWAL_PAY_USERNAME=
JAWWAL_PAY_PASSWORD=
JAWWAL_PAY_CLIENT_ID=
JAWWAL_PAY_CLIENT_SECRET=
# مفتاح HMAC الخاص بتوقيع طلبات /v1/*
JAWWAL_PAY_PRIVATE_KEY=
