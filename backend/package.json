{
  "name": "yalla-backend",
  "version": "1.0.0",
  "description": "Yalla - Real-time delivery backend (Express + Socket.io + MongoDB)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:region-admin": "node scripts/seed-region-admin.js",
    "seed:restaurants": "node scripts/seed-restaurants.js",
    "email:test": "node scripts/test-email.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:all": "node --test tests/*.test.js tests/integration/*.test.js",
    "migrate:media": "node scripts/migrate-file-assets-to-disk.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "multer": "^2.0.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@fastify/busboy": "3.2.2",
    "@grpc/grpc-js": "1.14.5",
    "engine.io": "6.6.11"
  },
  "engines": {
    "node": ">=22"
  }
}
