{
  "name": "yalla-backend",
  "version": "1.0.0",
  "description": "Yalla - Real-time delivery backend (Express + Socket.io + MongoDB)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:region-admin": "node scripts/seed-region-admin.js",
    "seed:restaurants": "node scripts/seed-restaurants.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:all": "node --test tests/*.test.js tests/integration/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1",
    "multer": "^2.0.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
