# منفذ السيرفر (على Oracle حدّده كما تريد، الافتراضي 3000)
PORT=3000

# مجلد حفظ جلسة واتساب
AUTH_FOLDER=auth_info

# روابط تطبيق يلا ديلفري (أندرويد + تطبيق الويب)
APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.mohammedemad333.yalla
APP_WEB_URL=https://app.yalladelivery.org/
APP_HOME_URL=https://yalladelivery.org/

# الربط برمز اقتران بدل QR
USE_PAIRING_CODE=true
# رقم واتساب الأعمال (صيغة دولية بدون +)
BUSINESS_NUMBER=970593456405
# رقم واتساب الدعم/التواصل الظاهر للعملاء
SUPPORT_NUMBER=+970593456405

# ===== معلومات الأسعار المعروضة للعملاء =====
# العملة المستخدمة في رسائل الأسعار العامة.
CURRENCY=₪

# مستوى السجلات: warn | info | debug
LOG_LEVEL=warn

# ===== المساعد الذكي (مجاني) =====
# يجيب على الأسئلة الحرّة للعملاء بلغة طبيعية عند خروجهم عن الأوامر المعروفة.
# فعّله/عطّله (افتراضياً مفعّل، لكنه يعمل فقط عند وجود مفتاح لأحد المزوّدين):
AI_ENABLED=true

# اختيار المزوّد: auto (الافتراضي — يختار أول مفتاح متوفّر) | gemini | groq
AI_PROVIDER=auto

# --- الخيار 1: Google Gemini ---
# مهم: يجب أن يكون المفتاح بصيغة AIzaSy...  (مفاتيح Agent Platform بصيغة AQ. لا تعمل!)
# مفتاح مجاني من: https://aistudio.google.com/apikey  (بدون بطاقة ائتمان)
GEMINI_API_KEY=
# النموذج (الافتراضي مجاني وسريع):
GEMINI_MODEL=gemini-2.0-flash
# نموذج احتياطي يُجرَّب تلقائياً لو كان الأساسي غير مدعوم (404):
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
# --- الخيار 2: Groq (مجاني وسريع — يتجاوز قيود مفاتيح Google) ---
# مفتاح مجاني بسيط (gsk_...) من: https://console.groq.com/keys
GROQ_API_KEY=
# النموذج (تأكد أنه ضمن المتاح لمفتاحك: curl https://api.groq.com/openai/v1/models):
GROQ_MODEL=openai/gpt-oss-20b
# نموذج احتياطي يُجرَّب تلقائياً لو الأساسي غير متاح (404):
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# عدد أدوار المحادثة المحفوظة لكل عميل كسياق (0 = بلا ذاكرة):
AI_MEMORY_TURNS=6
# حماية الحصة المجانية: أقصى عدد أسئلة للمساعد لكل عميل خلال النافذة (0 = بلا حدّ):
AI_RATE_MAX=8
AI_RATE_WINDOW_SEC=60
# أقصى طول لسؤال واحد يُرسل للمساعد (حماية للحصة وجودة الرد):
AI_MAX_INPUT_CHARS=1200
# حذف ذاكرة جلسة العميل بعد هذا العدد من دقائق الخمول:
AI_SESSION_TTL_MIN=60

# ===== التدخل البشري =====
# عند رد صاحب الحساب يدوياً على عميل، يتوقف البوت عن الرد لهذا العميل فقط
# ويعود تلقائياً بعد المدة التالية:
HUMAN_TAKEOVER_MIN=30

# ===== التصعيد الذكي للدعم =====
# بعد تكرار مشكلة/طلب دعم بهذا العدد خلال 15 دقيقة، يحوّل البوت المحادثة للبشر:
SMART_ESCALATION_REPEAT=2

# ===== أرقام الإدارة (لأوامر التشخيص فقط) =====
# أرقام تُتاح لها أوامر مثل "/حالة" لفحص المساعد الذكي (لا يراها العملاء).
# افتراضياً: رقم الأعمال + رقم الدعم. أضِف أرقاماً إضافية مفصولة بفاصلة (صيغة دولية):
ADMIN_NUMBERS=

# ===== حماية صفحات الإدارة HTTP =====
# مطلوب للوصول إلى /qr و /ai-status.
# استخدم قيمة عشوائية طويلة (32+ محرفاً) ولا تضعها في Git.
# مثال طلب:
# curl -H "Authorization: Bearer $ADMIN_HTTP_TOKEN" http://127.0.0.1:3000/ai-status
ADMIN_HTTP_TOKEN=


# ===== ربط البوت بـ Yalla Backend (قراءة فقط) =====
# يسمح للبوت بقراءة آخر طلب ورصيد الحساب المرتبط بنفس رقم واتساب.
YALLA_API_BASE_URL=https://api.yalladelivery.org
# يجب أن يطابق BOT_API_TOKEN على خادم Yalla Backend.
YALLA_BOT_API_TOKEN=
# مهلة طلب الـ API بالمللي ثانية.
YALLA_API_TIMEOUT_MS=5000
